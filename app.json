{
  "expo": {
    "name": "Recetas",
    "slug": "testing-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E4572E"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceder a tus fotos para elegir la imagen de una receta.",
          "cameraPermission": "La app necesita acceder a la cámara para tomar la foto de una receta."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F0",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#14100D"
          }
        }
      ]
    ]
  }
}
